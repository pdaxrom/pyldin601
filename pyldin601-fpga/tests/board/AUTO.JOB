ECHO OFF
REM Run from BOARDCHK after main-shell HANDLES 16 and RAMLOAD /CVM.
CLS
ECHO 01 RAMMAN
%1\RAMALLOC
ECHO JA01 READY
ECHO Expected: allocator succeeds; IRQs nonzero.
PAUSE
CLS
ECHO 02 DMA
%1\DMATEST
ECHO JA02 READY
ECHO Expected: copy/fill and PAL restored.
PAUSE
CLS
ECHO 03 VM and file IO
%2\HELLO
%2\CVMTEST
ECHO JA03 READY
ECHO Expected: HELLO and CVM both succeed.
PAUSE
CLS
ECHO 04 Compile C to ASM
%2\UNICC -o OUT.ASM HELLO.C
ECHO JA04 READY
ECHO Expected: zero compilation errors.
PAUSE
CLS
ECHO 05 Assemble and run CMD
%2\UNIAS -o OUT.CMD OUT.ASM
OUT.CMD
ECHO JA05 READY
ECHO Expected: compiled HELLO succeeds.
PAUSE
CLS
ECHO 06 Assemble object modules
%2\UNIAS -c -o OMAIN.OBJ MAIN.ASM
%2\UNIAS -c -o OHELP.OBJ HELP.ASM
ECHO JA06 READY
ECHO Expected: Both assemblies: no errors.
PAUSE
CLS
ECHO 07 Link and run objects
%2\UNILD -o PLAIN.PGM OMAIN.OBJ OHELP.OBJ
PLAIN.PGM
ECHO JA07 READY
ECHO Expected: object test succeeds.
PAUSE
CLS
ECHO 08 Create and list library
%2\UNIAR r TEST.LIB OHELP.OBJ
%2\UNIAR t TEST.LIB
ECHO JA08 READY
ECHO Expected: TEST.LIB must contain OHELP.
PAUSE
CLS
ECHO 09 Link and run library
%2\UNILD -o OBJLIB.PGM OMAIN.OBJ TEST.LIB
OBJLIB.PGM
ECHO JA09 READY
ECHO Expected: object test succeeds.
PAUSE
CLS
ECHO 10 Compile C object modules
%2\UNICC -c -o MIX.ASM MIX.C
%2\UNIAS -c -o MIX.OBJ MIX.ASM
%2\UNICC -c -o MINLINE.ASM MINLINE.C
%2\UNIAS -c -o MINLINE.OBJ MINLINE.ASM
ECHO JA10 READY
ECHO Expected: All four tools: no errors.
PAUSE
CLS
ECHO 11 Assemble native ABI modules
%2\UNIAS -c -o MNATIVE.OBJ MNATIVE.ASM
%2\UNIAS -c -o NENTRY.OBJ NENTRY.ASM
ECHO JA11 READY
ECHO Expected: Both assemblies: no errors.
PAUSE
CLS
ECHO 12 C to native to C callbacks
%2\UNILD -o MIXAPP.PGM @MIXAPP.LNK
MIXAPP.PGM
ECHO JA12 READY
ECHO Expected: C/native callback test succeeds.
PAUSE
CLS
ECHO 13 Native entry to C functions
%2\UNILD -o NENTRY.PGM @NENTRY.LNK
NENTRY.PGM
ECHO JA13 READY
ECHO Expected: mixed and native entry tests succeed.
PAUSE
ECHO JCHK AUTO END - inspect results
ECHO ON
